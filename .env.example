# Copy this file to `.env` and fill in your repository details.
# `.env` is gitignored — never commit real credentials.

# --- Deployment --------------------------------------------------------------
# Self-hosted is the only supported mode in v1. Cloud is reserved for v2.
LF_DEPLOYMENT_MODE=self_hosted

# Base URL of the Laserfiche Repository API Server (no trailing path).
LF_REPO_API_URL=https://lf.example.com/LFRepositoryAPI

# Repository name or ID to operate against.
LF_REPOSITORY_ID=my-repo

# LFRepositoryAPI version exposed by your server.
#   v1 → older self-hosted builds (default). Probe with:
#        GET {LF_REPO_API_URL}/v1/Repositories  → should return JSON 200.
#   v2 → newer self-hosted builds. Probe with:
#        GET {LF_REPO_API_URL}/v2/Repositories  → should return JSON 200.
# If the wrong value is set, every call fails with HTTP 400 "UnsupportedApiVersion".
LF_API_VERSION=v1

# --- Authentication ----------------------------------------------------------
# Choose one auth mode and fill the matching block.
#   password → username + password exchanged for a bearer token at
#              /{api_version}/Repositories/{repository}/Token (default; works
#              on both v1 and v2 self-hosted)
#   oauth    → OAuth 2.0 client_credentials grant (LFDS-compatible)
#   api_key  → reserved for cloud (JWT-signed assertion); not yet implemented
LF_AUTH_MODE=password

# Password grant
LF_USERNAME=service-account
LF_PASSWORD=replace-me

# OAuth (uncomment if LF_AUTH_MODE=oauth)
# LF_OAUTH_TOKEN_URL=https://lfds.example.com/STS/oauth/token
# LF_OAUTH_SCOPE=
# LF_CLIENT_ID=
# LF_CLIENT_SECRET=

# Cloud API key (reserved for v2)
# LF_API_KEY=

# --- Network ----------------------------------------------------------------
# Set false ONLY for self-signed cert dev environments. Emits a warning.
LF_VERIFY_SSL=true

# Per-request HTTP timeout in seconds.
LF_REQUEST_TIMEOUT_SECONDS=30

# Number of retries on transient failures (5xx, 429, connection errors).
# Each retry waits 2^attempt seconds (1s, 2s, 4s, ...).
LF_RETRY_ATTEMPTS=3

# --- Behavior ---------------------------------------------------------------
# Default to read-only. Set to 'false' to register the write tools (v1.2+).
LF_READ_ONLY=true

# Pagination limits.
LF_MAX_RESULTS_DEFAULT=25
LF_MAX_RESULTS_CEILING=200

# Dedicated page-size cap for search_natural. Some self-hosted servers reject
# SimpleSearches $top above an internal limit, so this defaults lower than the
# list/folder ceiling.
LF_MAX_PAGE_SIZE=100

# Cap on get_document_edoc downloads in bytes/text modes (default 25 MB).
LF_EDOC_MAX_BYTES=26214400

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LF_LOG_LEVEL=INFO

# --- Write-mode safety guards (only relevant when LF_READ_ONLY=false) -------
# All default off. Combine path fences with a tool allowlist for a sandbox setup.

# Comma-separated path prefixes; writes are PERMITTED only on entries whose
# fullPath starts with one of these (case-insensitive). Strongest single fence
# — recommended for any non-trivial write deployment.
# Example: LF_WRITE_PATHS_ALLOW=\Imports\Pending,\Archive\WIP
# LF_WRITE_PATHS_ALLOW=

# Comma-separated path prefixes where writes are REFUSED. Deny wins over allow.
# LF_WRITE_PATHS_DENY=

# Comma-separated write-tool names to scope what registers at startup. Useful
# for metadata-only or create-only deployments. Defense-in-depth: write tools
# also runtime-check their own name against this list.
# Example: LF_WRITE_TOOLS_ALLOWED=merge_fields,merge_tags,assign_template
# LF_WRITE_TOOLS_ALLOWED=

# Refuse folder deletes above this immediate-child count unless the caller
# passes force_large_delete=true alongside the confirmation token.
LF_DELETE_FOLDER_MAX_DESCENDANTS=50

# When true, delete_entry refuses to execute without an audit_reason_id.
# Use get_audit_reasons to enumerate valid IDs for the authenticated user.
LF_REQUIRE_AUDIT_REASON=false

# When true (default), assign_template preflights repository-wide required
# fields client-side and returns a structured missing_required_fields error
# instead of letting the server reject with the opaque "Multistatus
# response. [9039]" message. Set false on repos with no required fields
# to save the extra reads.
LF_VALIDATE_REQUIRED_FIELDS=true

# Client-side cap on import_document payload size (default 25 MB). The API's
# own cap is 100 MB; this defaults lower for safety.
LF_IMPORT_MAX_BYTES=26214400

# ---------------------------------------------------------------------------
# Remote HTTP transport (web clients) — only for `laserfiche-mcp --http`.
# Local clients (Claude Desktop, Cursor, Gemini CLI) use stdio and ignore these.
# ---------------------------------------------------------------------------

# Interface / port / path the --http server binds. Loopback by default so it is
# NOT reachable off the machine; set host to 0.0.0.0 only behind a TLS reverse
# proxy with an auth mode configured below.
# LF_HTTP_HOST=127.0.0.1
# LF_HTTP_PORT=8000
# LF_HTTP_PATH=/mcp

# Static shared bearer token — simplest auth for a single-tenant deployment.
# Required on every request when set. Ignored when OAuth (below) is enabled.
# LF_HTTP_AUTH_TOKEN=

# Per-user OAuth (Resource Server mode). Requires the extra:
#   pip install 'laserfiche-mcp[oauth]'
# Setting LF_HTTP_OAUTH_ISSUER turns it on; verified users are authenticated at
# the edge while Laserfiche calls still run as the service account above.
# See docs/remote-http.md for IdP registration and the security checklist.
# LF_HTTP_OAUTH_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# LF_HTTP_PUBLIC_URL=https://lf.example.com/mcp
# LF_HTTP_OAUTH_AUDIENCE=api://laserfiche-mcp
# LF_HTTP_OAUTH_REQUIRED_SCOPES=laserfiche.read
# LF_HTTP_OAUTH_JWKS_URL=
# LF_HTTP_OAUTH_ALGORITHMS=RS256
