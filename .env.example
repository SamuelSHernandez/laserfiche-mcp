# Copy this file to `.env` and fill in your repository details.
# `.env` is gitignored — never commit real credentials.

# --- Deployment --------------------------------------------------------------
# Self-hosted is the battle-tested mode — real deployments run it. Cloud is
# implemented against Laserfiche's documented service-app flow and its own
# open-source client library, but has never been exercised against a live
# Cloud tenant — treat as BETA until someone with Cloud access confirms it
# works end to end. Must be set together with LF_AUTH_MODE (below): cloud <-> api_key.
LF_DEPLOYMENT_MODE=self_hosted

# Base URL of the Repository API.
#   Self-hosted: your Repository API Server, no trailing path.
LF_REPO_API_URL=https://lf.example.com/LFRepositoryAPI
#   Cloud (BETA): https://api.laserfiche.com/repository — or, for a
#   non-US tenant, substitute your region, e.g. https://api.eu.laserfiche.com/repository
#   (same domain as the access key's "domain" field, api.<domain>/repository).

# Repository name or ID to operate against.
LF_REPOSITORY_ID=my-repo

# LFRepositoryAPI version exposed by your server.
#   v1 → older self-hosted builds (default). Probe with:
#        GET {LF_REPO_API_URL}/v1/Repositories  → should return JSON 200.
#   v2 → newer self-hosted builds, and required for Cloud. Probe with:
#        GET {LF_REPO_API_URL}/v2/Repositories  → should return JSON 200.
# If the wrong value is set, every call fails with HTTP 400 "UnsupportedApiVersion".
LF_API_VERSION=v1

# --- Authentication ----------------------------------------------------------
# Choose one auth mode and fill the matching block.
#   password → username + password exchanged for a bearer token at
#              /{api_version}/Repositories/{repository}/Token (default; works
#              on both v1 and v2 self-hosted)
#   oauth    → OAuth 2.0 client_credentials grant (LFDS-compatible)
#   api_key  → Laserfiche Cloud's service-app flow (JWT-signed assertion).
#              BETA — see the LF_DEPLOYMENT_MODE note above. Requires
#              LF_DEPLOYMENT_MODE=cloud.
LF_AUTH_MODE=password

# Password grant
LF_USERNAME=service-account
LF_PASSWORD=replace-me

# OAuth (uncomment if LF_AUTH_MODE=oauth)
# LF_OAUTH_TOKEN_URL=https://lfds.example.com/STS/oauth/token
# LF_OAUTH_SCOPE=
# LF_CLIENT_ID=
# LF_CLIENT_SECRET=

# Cloud service app (uncomment if LF_AUTH_MODE=api_key — BETA, unverified
# against a live tenant). Requires the `oauth` extra (PyJWT with the crypto
# backend) even though this isn't the --http OAuth Resource Server feature:
#   pip install 'laserfiche-mcp[oauth]'   # or: uv sync --extra oauth
# Two separate secrets, both from the Laserfiche
# Developer Console / Account Administration for an OAuth service app:
#   - LF_CLOUD_ACCESS_KEY: the base64-encoded access key blob (exported as
#     one piece from App Configuration > Authentication). Contains
#     customerId, domain, clientId, and an EC (P-256) signing key.
#   - LF_CLOUD_SERVICE_PRINCIPAL_KEY: the service principal key created for
#     the service principal in Account Administration — a separate secret,
#     not part of the access key blob.
# LF_CLOUD_ACCESS_KEY=
# LF_CLOUD_SERVICE_PRINCIPAL_KEY=
# LF_OAUTH_SCOPE=repository.Read repository.Write

# --- Network ----------------------------------------------------------------
# Set false ONLY for self-signed cert dev environments. Emits a warning.
LF_VERIFY_SSL=true

# Per-request HTTP timeout in seconds.
LF_REQUEST_TIMEOUT_SECONDS=30

# Number of retries on transient failures (5xx, 429, connection errors).
# Each retry waits 2^attempt seconds (1s, 2s, 4s, ...).
LF_RETRY_ATTEMPTS=3

# --- Behavior ---------------------------------------------------------------
# Default to read-only. Set to 'false' to register the write tools (v1.2+).
LF_READ_ONLY=true

# Pagination limits.
LF_MAX_RESULTS_DEFAULT=25
LF_MAX_RESULTS_CEILING=200

# Dedicated page-size cap for search_natural. Some self-hosted servers reject
# SimpleSearches $top above an internal limit, so this defaults lower than the
# list/folder ceiling.
LF_MAX_PAGE_SIZE=100

# Cap on get_document_edoc downloads in bytes/text modes (default 25 MB).
LF_EDOC_MAX_BYTES=25000000

# --- Web-client links ---------------------------------------------------------
# Unset by default: search/read tools omit `web_url` entirely until this is
# configured. Cannot be derived from LF_REPO_API_URL — the web client's
# host/path and URL scheme are deployment- and product-specific. Copy this by
# hand: open a document in your own Laserfiche web client, copy its browser
# URL, and substitute the entry ID (and repo name/ID, if present) with
# {entry_id} / {repo_id}. Opening the resulting link still requires the
# viewer's own Laserfiche web-client login and is subject to the repository's
# entry-level ACLs — it grants no access beyond that, so it's only useful in
# deployments where the people using it have their own Laserfiche logins.
#
# Examples seen in the wild (verify against your own install, don't assume):
#   Laserfiche Web Access:  https://lf.example.com/Laserfiche/DocView.aspx?repo={repo_id}&id={entry_id}
#   Laserfiche Cloud:       https://app.laserfiche.com/laserfiche/DocView.aspx?repo={repo_id}&id={entry_id}
# LF_WEB_CLIENT_URL_TEMPLATE=https://lf.example.com/Laserfiche/DocView.aspx?repo={repo_id}&id={entry_id}

# Same idea, for Folder/RecordSeries entries — most web clients browse a
# folder on a different page than they view a document on. Optional: leave
# unset to omit web_url for folders even when the template above is set.
# LF_WEB_CLIENT_FOLDER_URL_TEMPLATE=https://lf.example.com/Laserfiche/Browse.aspx?repo={repo_id}&id={entry_id}

# --- search_content (async /Searches flow) ----------------------------------
# How long to wait for an async search before abandoning it and releasing the
# search token. Full-text searches over large repositories are the slow case.
LF_SEARCH_TIMEOUT_SECONDS=60
# Delay between status polls while a search runs; backs off toward 2s.
LF_SEARCH_POLL_INTERVAL_SECONDS=1
# Hard cap on matched passages returned per entry, regardless of the
# caller-requested hits_per_entry.
LF_SEARCH_CONTEXT_HITS_MAX=10

# Register the v1.x verb-first tool aliases (get_entry, set_fields, ...)
# alongside the laserfiche_* names. Default changed to false in v2.3.0 —
# registering both roughly doubled the tool catalog the model pays for on
# every request. Set true if you still call tools by their legacy names.
LF_LEGACY_TOOL_NAMES=false

# Logging verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL).
LF_LOG_LEVEL=INFO

# Log line format: 'text' (human-readable, default) or 'json' (one JSON
# object per line — for jq / Datadog / Splunk pipelines).
LF_LOG_FORMAT=text

# Pre-flight field / tag / template / link-type names against the repo's
# cached schema definitions before write calls, returning structured
# invalid_*_name errors instead of opaque server 400s.
LF_VALIDATE_NAMES=true

# Cache window (seconds) for the schema-definition lookups behind
# LF_VALIDATE_NAMES and LF_VALIDATE_REQUIRED_FIELDS. 0 disables caching.
LF_SCHEMA_CACHE_TTL_SECONDS=300

# --- Write-mode safety guards (only relevant when LF_READ_ONLY=false) -------
# Path fences and the tool allowlist default off; the folder-delete batch cap
# (50) and required-field validation default ON. Combine path fences with a
# tool allowlist for a sandbox setup.

# Comma-separated path prefixes; writes are PERMITTED only on entries whose
# fullPath starts with one of these (case-insensitive). Strongest single fence
# — recommended for any non-trivial write deployment.
# Example: LF_WRITE_PATHS_ALLOW=\Imports\Pending,\Archive\WIP
# LF_WRITE_PATHS_ALLOW=

# Comma-separated path prefixes where writes are REFUSED. Deny wins over allow.
# LF_WRITE_PATHS_DENY=

# Comma-separated write-tool names to scope what registers at startup. Useful
# for metadata-only or create-only deployments. Defense-in-depth: write tools
# also runtime-check their own name against this list.
# Example: LF_WRITE_TOOLS_ALLOWED=merge_fields,merge_tags,assign_template
# LF_WRITE_TOOLS_ALLOWED=

# Refuse folder deletes above this immediate-child count unless the caller
# passes force_large_delete=true alongside the confirmation token.
LF_DELETE_FOLDER_MAX_DESCENDANTS=50

# When true, delete_entry refuses to execute without an audit_reason_id.
# Use get_audit_reasons to enumerate valid IDs for the authenticated user.
LF_REQUIRE_AUDIT_REASON=false

# Optional secret for signing destructive-operation confirmation tokens.
# Unset (default): a random per-process key — a server restart invalidates
# pending preview tokens, the safer single-instance default. Set it to a
# long random string to keep tokens valid across restarts and across
# instances sharing the secret (multi-instance / stateless deployments).
# Treat it like a password: anyone holding it can forge confirmation tokens.
# LF_CONFIRMATION_SECRET=

# When true (default), assign_template preflights the target template's own
# required fields (fields with a defaultValue are skipped — the server fills
# those in) client-side and returns a structured missing_required_fields
# error instead of letting the server reject with the opaque "Multistatus
# response. [9039]" message. Set false on repos with no required fields
# to save the extra reads.
LF_VALIDATE_REQUIRED_FIELDS=true

# Client-side cap on import_document payload size (default 25 MB). The API's
# own cap is 100 MB; this defaults lower for safety.
LF_IMPORT_MAX_BYTES=25000000

# Comma-separated local directories import_document may read source files
# from (symlinks resolved before comparison). Unset (default): any path the
# MCP process can read is accepted — set this in shared/multi-tenant
# deployments so a caller can't point file_path at an arbitrary file on the
# server's filesystem.
# Example: LF_IMPORT_SOURCE_DIRS=/srv/uploads,/tmp/lf-staging
# LF_IMPORT_SOURCE_DIRS=

# ---------------------------------------------------------------------------
# Remote HTTP transport (web clients) — only for `laserfiche-mcp --http`.
# Local clients (Claude Desktop, Cursor, Gemini CLI) use stdio and ignore these.
# ---------------------------------------------------------------------------

# Interface / port / path the --http server binds. Loopback by default so it is
# NOT reachable off the machine; set host to 0.0.0.0 only behind a TLS reverse
# proxy with an auth mode configured below.
# LF_HTTP_HOST=127.0.0.1
# LF_HTTP_PORT=8000
# LF_HTTP_PATH=/mcp

# Static shared bearer token — simplest auth for a single-tenant deployment.
# Required on every request when set. Ignored when OAuth (below) is enabled.
# LF_HTTP_AUTH_TOKEN=

# Per-user OAuth (Resource Server mode). Requires the extra:
#   pip install 'laserfiche-mcp[oauth]'
# Setting LF_HTTP_OAUTH_ISSUER turns it on; verified users are authenticated at
# the edge while Laserfiche calls still run as the service account above.
# See docs/remote-http.md for IdP registration and the security checklist.
# LF_HTTP_OAUTH_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# LF_HTTP_PUBLIC_URL=https://lf.example.com/mcp
# LF_HTTP_OAUTH_AUDIENCE=api://laserfiche-mcp
# LF_HTTP_OAUTH_REQUIRED_SCOPES=laserfiche.read
# LF_HTTP_OAUTH_JWKS_URL=
# LF_HTTP_OAUTH_ALGORITHMS=RS256

# Require this OAuth scope to EXECUTE delete_entry / delete_edoc /
# delete_pages (the three irreversible, content-destroying write tools) —
# previews stay open to any authenticated caller. OAuth mode only; grant the
# scope to humans, withhold it from an unattended/autonomous agent's
# client_credentials token, so destructive actions always need a human's own
# credential. move_entry and rename_entry are unaffected — they're reversible.
# LF_HTTP_OAUTH_DESTRUCTIVE_SCOPE=laserfiche.destructive
